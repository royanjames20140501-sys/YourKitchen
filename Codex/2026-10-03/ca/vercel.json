{
  "functions": {
    "api/cooking-help.js": {
      "maxDuration": 20
    },
    "api/recipe-ideas.js": {
      "maxDuration": 30
    },
    "api/feedback.js": {
      "maxDuration": 10
    },
    "api/community-recipes.js": {
      "maxDuration": 10
    },
    "api/community-reviews.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
